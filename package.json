{
  "name": "nuxt3-boilerplate",
  "author": "Iwo Strzeboński <iwo.strzebonski@gmail.com>",
  "version": "3.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nuxt dev --host",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "lint": "bun run lint:js && bun run lint:style",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"**/*.{vue,css}\" --fix",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "jest",
    "migration": "bun run ./migrations/index.mjs"
  },
  "lint-staged": {
    "*.{js,ts,mjs,vue}": "eslint --cache",
    "*.**": "prettier --check --ignore-unknown"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@nuxt/content": "^3.12.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/robots": "^5.7.1",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/typography": "^0.5.19",
    "chart.js": "^4.5.1",
    "chartjs-adapter-moment": "^1.0.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "flowbite": "^4.0.1",
    "flowbite-vue": "^0.2.3",
    "jose": "^6.2.2",
    "js-quantities": "^1.8.0",
    "kysely": "^0.28.14",
    "moment": "^2.30.1",
    "nuxt": "^4.4.2",
    "nuxt-content-assets": "^1.8.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "semver": "^7.7.1",
    "sitemap": "^9.0.1",
    "tailwindcss": "^4.2.2",
    "vue-chartjs": "^5.3.3",
    "vue-mermaid-string": "^8.0.2",
    "vue3-treeview": "^0.4.2",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/image": "^2.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/js-quantities": "^1.6.6",
    "@types/xml2js": "^0.4.14",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/compiler-sfc": "^3.5.30",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "postcss-html": "^1.8.1",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "stylelint": "^17.5.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-prettier": "^5.0.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
